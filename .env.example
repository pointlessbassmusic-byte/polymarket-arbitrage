# Copy to .env (never commit .env). Everything here is optional for paper trading.

# A fixed dashboard token, so the URL stays the same across restarts.
CRYPTOBOT_DASH_TOKEN=change-me-to-a-long-random-string

# Optional: a Discord or Slack incoming-webhook URL. Real fills and exits,
# reconciliation mismatches, daily-loss halts and startup are pushed there.
CRYPTOBOT_ALERT_WEBHOOK=

# ---- Real money only. Leave blank to paper trade. ----
# All three gates must agree before any order is sent: perp.live and
# carry.live in the config, this flag, and the keys below.
CRYPTOBOT_ARM_LIVE=
# Coinbase Derivatives (perp.venue: coinbase, the US venue). A CDP API key
# with trade permission only, ECDSA key type, futures enabled. Paste the
# PEM secret on one line with literal \n for newlines.
CRYPTOBOT_COINBASE_KEY_NAME=
CRYPTOBOT_COINBASE_KEY_SECRET=
# Kalshi perpetuals (perp.venue: kalshi). Key id and the private key PEM
# from kalshi.com/account/profile (Ed25519 recommended), PEM on one line
# with literal \n. Perps access is enabled per member; --preflight checks.
CRYPTOBOT_KALSHI_KEY_ID=
CRYPTOBOT_KALSHI_KEY_PEM=
# A DEDICATED Hyperliquid wallet (perp.venue: hyperliquid, non-US only).
CRYPTOBOT_PRIVATE_KEY=
# Kraken API key with "Query Funds", "Create & Modify Orders" and
# "Query Open/Closed Orders" ONLY. Never grant withdrawal.
CRYPTOBOT_KRAKEN_KEY=
CRYPTOBOT_KRAKEN_SECRET=
# Kraken's same key also drives spot-margin shorts when perp.venue: kraken
# (US margin unlocked in Kraken Pro). Still no withdrawal permission.

# ---- Other brokers (python -m cryptobot.brokers --probe reads them) ----
# Alpaca: US stocks/ETFs/options. Paper and live are DIFFERENT key pairs;
# with brokers.alpaca.live false the paper pair trades fake money.
CRYPTOBOT_ALPACA_KEY_ID=
CRYPTOBOT_ALPACA_SECRET_KEY=
# tastytrade: OAuth2 personal app (my.tastytrade.com -> Manage -> API):
# the app's client secret and a refresh token. Options/futures approval
# is set on the account, not the key.
CRYPTOBOT_TASTY_CLIENT_SECRET=
CRYPTOBOT_TASTY_REFRESH_TOKEN=
