# Copy to .env (never commit .env). Everything here is optional for paper trading.

# A fixed dashboard token, so the URL stays the same across restarts.
CRYPTOBOT_DASH_TOKEN=change-me-to-a-long-random-string

# ---- Real money only. Leave blank to paper trade. ----
# All three gates must agree before any order is sent: perp.live and
# carry.live in the config, this flag, and the keys below.
CRYPTOBOT_ARM_LIVE=
# A DEDICATED Hyperliquid wallet holding only what the desk may trade.
CRYPTOBOT_PRIVATE_KEY=
# Kraken API key with "Query Funds", "Create & Modify Orders" and
# "Query Open/Closed Orders" ONLY. Never grant withdrawal.
CRYPTOBOT_KRAKEN_KEY=
CRYPTOBOT_KRAKEN_SECRET=
